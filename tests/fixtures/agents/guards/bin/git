#!/bin/sh
set -eu
check_subcommand() {
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-C|-c|--git-dir|--work-tree|--namespace|--exec-path|--config-env)
				[ "$#" -ge 2 ] || break
				shift 2
				;;
			--git-dir=*|--work-tree=*|--namespace=*|--exec-path=*|--config-env=*)
				shift
				;;
			--bare|--no-pager|--literal-pathspecs|--no-optional-locks|--no-replace-objects|--no-lazy-fetch|--paginate)
				shift
				;;
			-*)
				shift
				;;
			*)
				break
				;;
		esac
	done
	if [ "${1-}" = push ]; then
		printf '%s\n' 'git push denied by PR0 disposable fixture' >> "${REX_PROJECTS_PROBE_GUARD_LOG:?}"
		exit 125
	fi
}
check_subcommand "$@"
exec /usr/bin/git "$@"
