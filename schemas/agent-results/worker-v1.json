{
  "$defs": {
    "AgentAssertion": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "succeeded",
              "type": "string"
            }
          },
          "required": [
            "assertion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "blocked",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "assertion",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "failed",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "assertion",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "cancelled",
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "assertion"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactId": {
      "allOf": [
        {
          "description": "Opaque stable identity for a host-registered Agent artifact.\n\nThe syntax is deliberately identical to a SHA-256 digest, but an\n`ArtifactId` is not itself proof that the host registered or acknowledged\nan artifact. Consumers must resolve it against host-owned registration\nstate.",
          "type": "string"
        },
        {
          "description": "Opaque stable identity for a host-registered Agent artifact.\n\nThe syntax is deliberately identical to a SHA-256 digest, but an\n`ArtifactId` is not itself proof that the host registered or acknowledged\nan artifact. Consumers must resolve it against host-owned registration\nstate.",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      ]
    },
    "ChangeReference": {
      "additionalProperties": false,
      "properties": {
        "base_commit": {
          "maxLength": 64,
          "minLength": 40,
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "type": "string"
        },
        "branch_head": {
          "maxLength": 64,
          "minLength": 40,
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "type": "string"
        },
        "commit_mode": {
          "$ref": "#/$defs/CommitMode"
        },
        "commit_shas": {
          "items": {
            "maxLength": 64,
            "minLength": 40,
            "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "host_commit_operation_id": {
          "description": "Host-mode commits must name the durable `repository.commit` receipt whose SHA is reported above.",
          "type": [
            "string",
            "null"
          ]
        },
        "previous_head": {
          "maxLength": 64,
          "minLength": 40,
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "type": "string"
        },
        "repository": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "worktree_id": {
          "$ref": "#/$defs/WorkNodeId",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": [
        "repository",
        "worktree_id",
        "commit_mode",
        "base_commit",
        "previous_head",
        "branch_head",
        "commit_shas"
      ],
      "type": "object"
    },
    "CommitMode": {
      "enum": [
        "auto",
        "native",
        "host"
      ],
      "type": "string"
    },
    "RoleArtifactKind": {
      "enum": [
        "change",
        "test_receipt",
        "general"
      ],
      "type": "string"
    },
    "RoleArtifactReference": {
      "allOf": [
        {
          "additionalProperties": false,
          "description": "A host-registered artifact locator returned after the AgentRun request path\nhas been safely copied and its bytes have been checked. The opaque ID is\nstill only a reference: readers must resolve it in host-owned registration\nstate and verify the immutable receipt before relying on it.",
          "properties": {
            "artifact_id": {
              "$ref": "#/$defs/ArtifactId",
              "description": "Host-minted stable identity. This identifier alone is not an\nacknowledgement; consumers must resolve it in host-owned registration\nstate before relying on the referenced artifact."
            },
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "digest": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/RoleArtifactKind"
            },
            "path": {
              "description": "Normalized relative locator in the host-managed artifact store, at most\n1,024 Unicode scalar values and 4,096 UTF-8 bytes.",
              "type": "string"
            },
            "schema_version": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "artifact_id",
            "kind",
            "schema_version",
            "path",
            "digest",
            "bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A host-registered artifact locator returned after the AgentRun request path\nhas been safely copied and its bytes have been checked. The opaque ID is\nstill only a reference: readers must resolve it in host-owned registration\nstate and verify the immutable receipt before relying on it.",
          "properties": {
            "artifact_id": {
              "$ref": "#/$defs/ArtifactId",
              "description": "Host-minted stable identity. This identifier alone is not an\nacknowledgement; consumers must resolve it in host-owned registration\nstate before relying on the referenced artifact."
            },
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "digest": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/RoleArtifactKind"
            },
            "path": {
              "description": "Normalized relative locator in the host-managed artifact store, at most\n1,024 Unicode scalar values and 4,096 UTF-8 bytes.",
              "maxLength": 1024,
              "minLength": 1,
              "not": {
                "pattern": "^[^/]:"
              },
              "pattern": "^(?![A-Za-z]:)(?:[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.\\.[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*)((?:/(?:[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.\\.[^/\\\\\\p{Cc}][^/\\\\\\p{Cc}]*))*)$",
              "type": "string"
            },
            "schema_version": {
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "artifact_id",
            "kind",
            "schema_version",
            "path",
            "digest",
            "bytes"
          ],
          "type": "object"
        }
      ]
    },
    "RoleOutputKind": {
      "enum": [
        "progress",
        "irregularity",
        "human_request",
        "ticket_proposal",
        "dispatch_request",
        "intervention",
        "spawn_request",
        "investigation_request",
        "prepare_worktrees",
        "plan_ready",
        "implementation_ready",
        "verification_ready",
        "review_ready",
        "merge_assessment",
        "merge_intent",
        "operation_action",
        "operation_result",
        "postmortem_ready",
        "learning_decision",
        "profile_trial_result",
        "profile_promotion_proposal"
      ],
      "type": "string"
    },
    "WorkNodeId": {
      "description": "Stable plan-local identity for a task in a TicketRun DAG.",
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "type": "string"
    }
  },
  "$id": "https://rex-projects.dev/schemas/agent-results/worker-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "progress"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "completed_node_keys": {
                  "items": {
                    "$ref": "#/$defs/WorkNodeId"
                  },
                  "type": "array"
                },
                "evidence": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                },
                "next_observation_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pending_node_keys": {
                  "items": {
                    "$ref": "#/$defs/WorkNodeId"
                  },
                  "type": "array"
                },
                "summary": {
                  "type": "string"
                }
              },
              "required": [
                "summary",
                "completed_node_keys",
                "pending_node_keys",
                "evidence"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "irregularity"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "affected_node_keys": {
                  "items": {
                    "$ref": "#/$defs/WorkNodeId",
                    "maxLength": 80,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9._-]+$"
                  },
                  "type": "array"
                },
                "observed_facts": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "proposed_options": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "requested_pause_scope": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                },
                "source_references": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                }
              },
              "required": [
                "severity",
                "observed_facts",
                "source_references",
                "affected_node_keys",
                "requested_pause_scope",
                "proposed_options"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "human_request"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "choices": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "evidence_references": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                },
                "kind": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "requested_continuation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "subject_digest": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "question",
                "choices",
                "evidence_references",
                "subject_digest"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "implementation_ready"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "change_references": {
                  "items": {
                    "$ref": "#/$defs/ChangeReference"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "completed_acceptance_items": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "irregularity_references": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                },
                "unresolved_items": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "change_references",
                "completed_acceptance_items",
                "unresolved_items",
                "irregularity_references"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "verification_ready"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "publication_operation_id": {
                  "type": "string"
                },
                "published_head": {
                  "type": "string"
                },
                "repository": {
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                  "type": "string"
                },
                "test_receipt_artifact_ids": {
                  "items": {
                    "$ref": "#/$defs/ArtifactId"
                  },
                  "type": "array"
                },
                "work_node_id": {
                  "$ref": "#/$defs/WorkNodeId"
                }
              },
              "required": [
                "work_node_id",
                "repository",
                "publication_operation_id",
                "published_head",
                "test_receipt_artifact_ids"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        }
      ]
    }
  ],
  "description": "The wire shape emitted by an Agent. Host-owned run binding is attached after\nreading the scoped mailbox; an Agent cannot choose its authority fields.",
  "properties": {
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/RoleArtifactReference"
      },
      "maxItems": 256,
      "type": "array"
    },
    "assertion": {
      "$ref": "#/$defs/AgentAssertion"
    },
    "kind": {
      "enum": [
        "progress",
        "irregularity",
        "human_request",
        "implementation_ready",
        "verification_ready"
      ]
    },
    "message_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "result_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "structured_result": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "kind",
    "assertion",
    "structured_result",
    "artifact_refs"
  ],
  "title": "rex-projects worker result message",
  "type": "object"
}
