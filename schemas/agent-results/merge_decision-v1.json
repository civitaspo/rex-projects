{
  "$defs": {
    "AgentAssertion": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "succeeded",
              "type": "string"
            }
          },
          "required": [
            "assertion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "blocked",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "assertion",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "failed",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "assertion",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "cancelled",
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "assertion"
          ],
          "type": "object"
        }
      ]
    },
    "DeterministicGateEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_references": {
          "items": {
            "$ref": "#/$defs/RoleArtifactReference"
          },
          "minItems": 1,
          "type": "array"
        },
        "gate_id": {
          "minLength": 1,
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/GateOutcome"
        }
      },
      "required": [
        "gate_id",
        "outcome",
        "evidence_references"
      ],
      "type": "object"
    },
    "GateOutcome": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ],
      "type": "string"
    },
    "MergeConfidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "MergeProcedureStep": {
      "additionalProperties": false,
      "properties": {
        "instruction_reference": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MergeProcedureStepKind"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "instruction_reference",
        "rationale"
      ],
      "type": "object"
    },
    "MergeProcedureStepKind": {
      "enum": [
        "update_pull_request_body",
        "request_merge",
        "direct_merge",
        "verify_merge_commit"
      ],
      "type": "string"
    },
    "PostMergeVerification": {
      "additionalProperties": false,
      "properties": {
        "instruction_reference": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PostMergeVerificationKind"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "instruction_reference",
        "rationale"
      ],
      "type": "object"
    },
    "PostMergeVerificationKind": {
      "enum": [
        "merge_commit_recorded",
        "target_branch_contains_commit",
        "required_checks_remain_green",
        "deployment_observed"
      ],
      "type": "string"
    },
    "RiskFactorAssessment": {
      "additionalProperties": false,
      "properties": {
        "evidence_references": {
          "items": {
            "$ref": "#/$defs/RoleArtifactReference"
          },
          "minItems": 1,
          "type": "array"
        },
        "rating": {
          "format": "uint8",
          "maximum": 4,
          "minimum": 0,
          "type": "integer"
        },
        "rationale": {
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "uncertainty": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "rating",
        "source",
        "rationale",
        "evidence_references"
      ],
      "type": "object"
    },
    "RoleArtifactKind": {
      "enum": [
        "merge_assessment",
        "general"
      ],
      "type": "string"
    },
    "RoleArtifactReference": {
      "allOf": [
        {
          "additionalProperties": false,
          "description": "A pointer into this AgentRun's registered output root. The host artifact\nregistrar must still open without following links, copy, hash and publish\nthe same bytes before acknowledging the reference.",
          "properties": {
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "digest": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/RoleArtifactKind"
            },
            "path": {
              "type": "string"
            },
            "schema_version": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "schema_version",
            "path",
            "digest",
            "bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A pointer into this AgentRun's registered output root. The host artifact\nregistrar must still open without following links, copy, hash and publish\nthe same bytes before acknowledging the reference.",
          "properties": {
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "digest": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/RoleArtifactKind"
            },
            "path": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^(?:[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.\\.[^/\\\\\\p{Cc}][^/\\\\\\p{Cc}]*)(?:/(?:[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.\\.[^/\\\\\\p{Cc}][^/\\\\\\p{Cc}]*))*$",
              "type": "string"
            },
            "schema_version": {
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "schema_version",
            "path",
            "digest",
            "bytes"
          ],
          "type": "object"
        }
      ]
    },
    "RoleOutputKind": {
      "enum": [
        "progress",
        "irregularity",
        "human_request",
        "ticket_proposal",
        "dispatch_request",
        "intervention",
        "spawn_request",
        "investigation_request",
        "prepare_worktrees",
        "plan_ready",
        "implementation_ready",
        "review_ready",
        "merge_assessment",
        "merge_intent",
        "operation_action",
        "operation_result",
        "postmortem_ready",
        "learning_decision",
        "profile_trial_result",
        "profile_promotion_proposal"
      ],
      "type": "string"
    },
    "WorkNodeId": {
      "description": "Stable plan-local identity for a task in a TicketRun DAG.",
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "type": "string"
    }
  },
  "$id": "https://rex-projects.dev/schemas/agent-results/merge_decision-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "progress"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "completed_node_keys": {
                  "items": {
                    "$ref": "#/$defs/WorkNodeId"
                  },
                  "type": "array"
                },
                "evidence": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                },
                "next_observation_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pending_node_keys": {
                  "items": {
                    "$ref": "#/$defs/WorkNodeId"
                  },
                  "type": "array"
                },
                "summary": {
                  "type": "string"
                }
              },
              "required": [
                "summary",
                "completed_node_keys",
                "pending_node_keys",
                "evidence"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "irregularity"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "affected_node_keys": {
                  "items": {
                    "$ref": "#/$defs/WorkNodeId",
                    "maxLength": 80,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9._-]+$"
                  },
                  "type": "array"
                },
                "observed_facts": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "proposed_options": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "requested_pause_scope": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                },
                "source_references": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                }
              },
              "required": [
                "severity",
                "observed_facts",
                "source_references",
                "affected_node_keys",
                "requested_pause_scope",
                "proposed_options"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "human_request"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "choices": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "evidence_references": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                },
                "kind": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "requested_continuation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "subject_digest": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "question",
                "choices",
                "evidence_references",
                "subject_digest"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "merge_assessment"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "confidence": {
                  "$ref": "#/$defs/MergeConfidence"
                },
                "deterministic_gate_evidence": {
                  "items": {
                    "$ref": "#/$defs/DeterministicGateEvidence"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "disposition": {
                  "minLength": 1,
                  "type": "string"
                },
                "pr_references": {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "ratings": {
                  "additionalProperties": false,
                  "maxProperties": 5,
                  "minProperties": 5,
                  "properties": {
                    "change_impact": {
                      "$ref": "#/$defs/RiskFactorAssessment"
                    },
                    "complexity": {
                      "$ref": "#/$defs/RiskFactorAssessment"
                    },
                    "operational_exposure": {
                      "$ref": "#/$defs/RiskFactorAssessment"
                    },
                    "review_uncertainty": {
                      "$ref": "#/$defs/RiskFactorAssessment"
                    },
                    "verification_gaps": {
                      "$ref": "#/$defs/RiskFactorAssessment"
                    }
                  },
                  "propertyNames": {
                    "enum": [
                      "change_impact",
                      "complexity",
                      "verification_gaps",
                      "review_uncertainty",
                      "operational_exposure"
                    ]
                  },
                  "type": "object"
                },
                "rationale": {
                  "minLength": 1,
                  "type": "string"
                },
                "subject_digest": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "pr_references",
                "subject_digest",
                "deterministic_gate_evidence",
                "ratings",
                "confidence",
                "rationale",
                "disposition"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "merge_intent"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "assessment_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "policy_digest": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "post_merge_verification": {
                  "items": {
                    "$ref": "#/$defs/PostMergeVerification"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "pr_identities": {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "prepared_body_digest": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "steps": {
                  "items": {
                    "$ref": "#/$defs/MergeProcedureStep"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "assessment_id",
                "pr_identities",
                "policy_digest",
                "prepared_body_digest",
                "steps",
                "post_merge_verification"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        }
      ]
    }
  ],
  "description": "The wire shape emitted by an Agent. Host-owned run binding is attached after\nreading the scoped mailbox; an Agent cannot choose its authority fields.",
  "properties": {
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/RoleArtifactReference"
      },
      "maxItems": 256,
      "type": "array"
    },
    "assertion": {
      "$ref": "#/$defs/AgentAssertion"
    },
    "kind": {
      "enum": [
        "progress",
        "irregularity",
        "human_request",
        "merge_assessment",
        "merge_intent"
      ]
    },
    "message_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "result_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "structured_result": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "kind",
    "assertion",
    "structured_result",
    "result_digest",
    "artifact_refs"
  ],
  "title": "rex-projects merge_decision result message",
  "type": "object"
}
