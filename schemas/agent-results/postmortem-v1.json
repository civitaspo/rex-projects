{
  "$defs": {
    "AgentAssertion": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "succeeded",
              "type": "string"
            }
          },
          "required": [
            "assertion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "blocked",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "assertion",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "failed",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "assertion",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "cancelled",
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "assertion"
          ],
          "type": "object"
        }
      ]
    },
    "RoleArtifactKind": {
      "enum": [
        "postmortem",
        "general"
      ],
      "type": "string"
    },
    "RoleArtifactReference": {
      "allOf": [
        {
          "additionalProperties": false,
          "description": "A pointer into this AgentRun's registered output root. The host artifact\nregistrar must still open without following links, copy, hash and publish\nthe same bytes before acknowledging the reference.",
          "properties": {
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "digest": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/RoleArtifactKind"
            },
            "path": {
              "type": "string"
            },
            "schema_version": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "schema_version",
            "path",
            "digest",
            "bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A pointer into this AgentRun's registered output root. The host artifact\nregistrar must still open without following links, copy, hash and publish\nthe same bytes before acknowledging the reference.",
          "properties": {
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "digest": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/RoleArtifactKind"
            },
            "path": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^(?:[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.\\.[^/\\\\\\p{Cc}][^/\\\\\\p{Cc}]*)(?:/(?:[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.\\.[^/\\\\\\p{Cc}][^/\\\\\\p{Cc}]*))*$",
              "type": "string"
            },
            "schema_version": {
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "schema_version",
            "path",
            "digest",
            "bytes"
          ],
          "type": "object"
        }
      ]
    },
    "RoleOutputKind": {
      "enum": [
        "progress",
        "irregularity",
        "human_request",
        "ticket_proposal",
        "dispatch_request",
        "intervention",
        "spawn_request",
        "investigation_request",
        "prepare_worktrees",
        "plan_ready",
        "implementation_ready",
        "review_ready",
        "merge_assessment",
        "merge_intent",
        "operation_action",
        "operation_result",
        "postmortem_ready",
        "learning_decision",
        "profile_trial_result",
        "profile_promotion_proposal"
      ],
      "type": "string"
    },
    "WorkNodeId": {
      "description": "Stable plan-local identity for a task in a TicketRun DAG.",
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "type": "string"
    }
  },
  "$id": "https://rex-projects.dev/schemas/agent-results/postmortem-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "progress"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "completed_node_keys": {
                  "items": {
                    "$ref": "#/$defs/WorkNodeId"
                  },
                  "type": "array"
                },
                "evidence": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                },
                "next_observation_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pending_node_keys": {
                  "items": {
                    "$ref": "#/$defs/WorkNodeId"
                  },
                  "type": "array"
                },
                "summary": {
                  "type": "string"
                }
              },
              "required": [
                "summary",
                "completed_node_keys",
                "pending_node_keys",
                "evidence"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "irregularity"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "affected_node_keys": {
                  "items": {
                    "$ref": "#/$defs/WorkNodeId",
                    "maxLength": 80,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9._-]+$"
                  },
                  "type": "array"
                },
                "observed_facts": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "proposed_options": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "requested_pause_scope": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                },
                "source_references": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                }
              },
              "required": [
                "severity",
                "observed_facts",
                "source_references",
                "affected_node_keys",
                "requested_pause_scope",
                "proposed_options"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "human_request"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "choices": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "evidence_references": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                },
                "kind": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "requested_continuation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "subject_digest": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "question",
                "choices",
                "evidence_references",
                "subject_digest"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "postmortem_ready"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "candidate_publication_manifest": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "findings": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "source_references": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                },
                "unresolved_provenance": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "candidate_publication_manifest",
                "findings",
                "source_references",
                "unresolved_provenance"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        }
      ]
    }
  ],
  "description": "The wire shape emitted by an Agent. Host-owned run binding is attached after\nreading the scoped mailbox; an Agent cannot choose its authority fields.",
  "properties": {
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/RoleArtifactReference"
      },
      "maxItems": 256,
      "type": "array"
    },
    "assertion": {
      "$ref": "#/$defs/AgentAssertion"
    },
    "kind": {
      "enum": [
        "progress",
        "irregularity",
        "human_request",
        "postmortem_ready"
      ]
    },
    "message_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "result_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "structured_result": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "kind",
    "assertion",
    "structured_result",
    "result_digest",
    "artifact_refs"
  ],
  "title": "rex-projects postmortem result message",
  "type": "object"
}
