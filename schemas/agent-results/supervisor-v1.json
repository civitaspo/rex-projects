{
  "$defs": {
    "AgentAssertion": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "succeeded",
              "type": "string"
            }
          },
          "required": [
            "assertion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "blocked",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "assertion",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "failed",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "assertion",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assertion": {
              "const": "cancelled",
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "assertion"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactId": {
      "allOf": [
        {
          "description": "Opaque stable identity for a host-registered Agent artifact.\n\nThe syntax is deliberately identical to a SHA-256 digest, but an\n`ArtifactId` is not itself proof that the host registered or acknowledged\nan artifact. Consumers must resolve it against host-owned registration\nstate.",
          "type": "string"
        },
        {
          "description": "Opaque stable identity for a host-registered Agent artifact.\n\nThe syntax is deliberately identical to a SHA-256 digest, but an\n`ArtifactId` is not itself proof that the host registered or acknowledged\nan artifact. Consumers must resolve it against host-owned registration\nstate.",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      ]
    },
    "RoleArtifactKind": {
      "enum": [
        "learning",
        "general"
      ],
      "type": "string"
    },
    "RoleArtifactReference": {
      "allOf": [
        {
          "additionalProperties": false,
          "description": "A host-registered artifact locator returned after the AgentRun request path\nhas been safely copied and its bytes have been checked. The opaque ID is\nstill only a reference: readers must resolve it in host-owned registration\nstate and verify the immutable receipt before relying on it.",
          "properties": {
            "artifact_id": {
              "$ref": "#/$defs/ArtifactId",
              "description": "Host-minted stable identity. This identifier alone is not an\nacknowledgement; consumers must resolve it in host-owned registration\nstate before relying on the referenced artifact."
            },
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "digest": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/RoleArtifactKind"
            },
            "path": {
              "description": "Normalized relative locator in the host-managed artifact store, at most\n1,024 Unicode scalar values and 4,096 UTF-8 bytes.",
              "type": "string"
            },
            "schema_version": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "artifact_id",
            "kind",
            "schema_version",
            "path",
            "digest",
            "bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A host-registered artifact locator returned after the AgentRun request path\nhas been safely copied and its bytes have been checked. The opaque ID is\nstill only a reference: readers must resolve it in host-owned registration\nstate and verify the immutable receipt before relying on it.",
          "properties": {
            "artifact_id": {
              "$ref": "#/$defs/ArtifactId",
              "description": "Host-minted stable identity. This identifier alone is not an\nacknowledgement; consumers must resolve it in host-owned registration\nstate before relying on the referenced artifact."
            },
            "bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "digest": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/RoleArtifactKind"
            },
            "path": {
              "description": "Normalized relative locator in the host-managed artifact store, at most\n1,024 Unicode scalar values and 4,096 UTF-8 bytes.",
              "maxLength": 1024,
              "minLength": 1,
              "not": {
                "pattern": "^[^/]:"
              },
              "pattern": "^(?![A-Za-z]:)(?:[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.\\.[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*)((?:/(?:[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.[^./\\\\\\p{Cc}][^/\\\\\\p{Cc}]*|\\.\\.[^/\\\\\\p{Cc}][^/\\\\\\p{Cc}]*))*)$",
              "type": "string"
            },
            "schema_version": {
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "artifact_id",
            "kind",
            "schema_version",
            "path",
            "digest",
            "bytes"
          ],
          "type": "object"
        }
      ]
    },
    "RoleOutputKind": {
      "enum": [
        "progress",
        "irregularity",
        "human_request",
        "ticket_proposal",
        "dispatch_request",
        "intervention",
        "spawn_request",
        "investigation_request",
        "prepare_worktrees",
        "plan_ready",
        "implementation_ready",
        "review_ready",
        "merge_assessment",
        "merge_intent",
        "operation_action",
        "operation_result",
        "postmortem_ready",
        "learning_decision",
        "profile_trial_result",
        "profile_promotion_proposal"
      ],
      "type": "string"
    },
    "RoleSessionId": {
      "description": "Local logical identity for a durable role session. It is not an Agent\nsupplied destination; validation matches it against the host descriptor.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+(:[A-Za-z0-9._-]+)*$",
      "type": "string"
    },
    "WorkNodeId": {
      "description": "Stable plan-local identity for a task in a TicketRun DAG.",
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "type": "string"
    }
  },
  "$id": "https://rex-projects.dev/schemas/agent-results/supervisor-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "progress"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "completed_node_keys": {
                  "items": {
                    "$ref": "#/$defs/WorkNodeId"
                  },
                  "type": "array"
                },
                "evidence": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                },
                "next_observation_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pending_node_keys": {
                  "items": {
                    "$ref": "#/$defs/WorkNodeId"
                  },
                  "type": "array"
                },
                "summary": {
                  "type": "string"
                }
              },
              "required": [
                "summary",
                "completed_node_keys",
                "pending_node_keys",
                "evidence"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "irregularity"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "affected_node_keys": {
                  "items": {
                    "$ref": "#/$defs/WorkNodeId",
                    "maxLength": 80,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9._-]+$"
                  },
                  "type": "array"
                },
                "observed_facts": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "proposed_options": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "requested_pause_scope": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                },
                "source_references": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                }
              },
              "required": [
                "severity",
                "observed_facts",
                "source_references",
                "affected_node_keys",
                "requested_pause_scope",
                "proposed_options"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "human_request"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "choices": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "evidence_references": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                },
                "kind": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "requested_continuation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "subject_digest": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "question",
                "choices",
                "evidence_references",
                "subject_digest"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "ticket_proposal"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "acceptance": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "body": {
                  "type": "string"
                },
                "dependencies": {
                  "items": {
                    "maxLength": 512,
                    "minLength": 1,
                    "pattern": "^[^\\p{Cc}]*$",
                    "type": "string"
                  },
                  "type": "array"
                },
                "gap_key": {
                  "type": "string"
                },
                "goal_revision": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "parent": {
                  "maxLength": 512,
                  "minLength": 1,
                  "pattern": "^[^\\p{Cc}]*$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "priority_rationale": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "goal_revision",
                "gap_key",
                "title",
                "body",
                "acceptance",
                "priority_rationale",
                "dependencies"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "dispatch_request"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "coordinator_profile": {
                  "type": "string"
                },
                "expected_ticket_revision": {
                  "description": "Copy `payload_json.external_revision` byte-for-byte from the same ticket observation.",
                  "type": "string"
                },
                "priority": {
                  "format": "int32",
                  "type": "integer"
                },
                "rationale": {
                  "type": "string"
                },
                "ticket_reference": {
                  "description": "Copy `payload_json.ticket_id` byte-for-byte from the selected current ticket observation.\nDo not add a namespace, adapter name, URL, or source identifier unless it is part of that\nticket ID itself.",
                  "maxLength": 512,
                  "minLength": 1,
                  "pattern": "^[^\\p{Cc}]*$",
                  "type": "string"
                }
              },
              "required": [
                "ticket_reference",
                "expected_ticket_revision",
                "coordinator_profile",
                "priority",
                "rationale"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "intervention"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "coordinator_role_session_id": {
                  "$ref": "#/$defs/RoleSessionId",
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._-]+(:[A-Za-z0-9._-]+)*$"
                },
                "evidence": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                },
                "proposed_plan_change": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "ticket_run_revision": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "coordinator_role_session_id",
                "ticket_run_revision",
                "reason",
                "evidence",
                "proposed_plan_change"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "learning_decision"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "batch_digest": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "batch_id": {
                  "type": "string"
                },
                "candidate_change": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "checkpoint": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "config_revision": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "improvements": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "observations": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "topic_changes": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "batch_id",
                "batch_digest",
                "config_revision",
                "observations",
                "topic_changes",
                "checkpoint",
                "improvements"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "profile_trial_result"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "authorization_receipt": {
                  "type": "string"
                },
                "base_digest": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "candidate_digest": {
                  "maxLength": 64,
                  "minLength": 64,
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                "evidence_references": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                },
                "frozen_inputs": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "outcome": {
                  "type": "string"
                },
                "run_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "candidate_digest",
                "base_digest",
                "authorization_receipt",
                "run_ids",
                "frozen_inputs",
                "evidence_references",
                "outcome"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "profile_promotion_proposal"
            },
            "structured_result": {
              "additionalProperties": false,
              "properties": {
                "candidate_revision": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "efficacy_outcome": {
                  "type": "string"
                },
                "evidence_references": {
                  "items": {
                    "$ref": "#/$defs/RoleArtifactReference"
                  },
                  "type": "array"
                },
                "expected_target_digests": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "managed_slot": {
                  "type": "string"
                },
                "profile_diff": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "uncertain_efficacy_exception": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": [
                    "object",
                    "null"
                  ]
                }
              },
              "required": [
                "candidate_revision",
                "efficacy_outcome",
                "evidence_references",
                "managed_slot",
                "profile_diff",
                "expected_target_digests"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "structured_result"
          ],
          "type": "object"
        }
      ]
    }
  ],
  "description": "The wire shape emitted by an Agent. Host-owned run binding is attached after\nreading the scoped mailbox; an Agent cannot choose its authority fields.",
  "properties": {
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/RoleArtifactReference"
      },
      "maxItems": 256,
      "type": "array"
    },
    "assertion": {
      "$ref": "#/$defs/AgentAssertion"
    },
    "kind": {
      "enum": [
        "progress",
        "irregularity",
        "human_request",
        "ticket_proposal",
        "dispatch_request",
        "intervention",
        "learning_decision",
        "profile_trial_result",
        "profile_promotion_proposal"
      ]
    },
    "message_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "result_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "structured_result": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "kind",
    "assertion",
    "structured_result",
    "artifact_refs"
  ],
  "title": "rex-projects supervisor result message",
  "type": "object"
}
