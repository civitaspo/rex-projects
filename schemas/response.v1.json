{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "not_found",
        "unauthorized",
        "forbidden",
        "conflict",
        "rate_limited",
        "unavailable",
        "unsupported",
        "invalid_request"
      ],
      "type": "string"
    },
    "ProtocolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "message": {
          "type": "string"
        },
        "retry_after_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProtocolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "extensions": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "request_id": {
      "type": "string"
    },
    "result": true,
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "request_id"
  ],
  "title": "ResponseEnvelope",
  "type": "object"
}
