{
  "$defs": {
    "Role": {
      "enum": [
        "supervisor",
        "coordinator",
        "planner",
        "worker",
        "reviewer",
        "merge_decision",
        "operator",
        "postmortem"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "expected_subject_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "method": {
      "type": "string"
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "params": true,
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "role": {
      "anyOf": [
        {
          "$ref": "#/$defs/Role"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_epoch": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "type": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "method",
    "params"
  ],
  "title": "RequestEnvelope",
  "type": "object"
}
